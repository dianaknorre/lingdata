                <ANNOTATION_VALUE>честно это </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts9">
                <ANNOTATION_VALUE>немного забавный вопрос</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>я / как бы долго засматривалась на лингвистику</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>потом когда / я пришла в десятый класс и меня поставили / такой в предпринимательский класс</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618"
                TIME_SLOT_REF1="ts28" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE> и меня поставили / такой в предпринимательский класс</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>я честно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>я с= как бы сдавала обществознание</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>потому что с языком это наверное единственный предмет который я могла сдать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>потому что нет литературе /  с моей памятью</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts77">
                <ANNOTATION_VALUE>нет / эа истории точно с моей памятью</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts78" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>география / я даже не рассматривала варианты</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>потому что я не очень люблю своего учителя по географии</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>и как бы единственный вариант если я хочу сдавать / а / английский язык </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>был для меня обществознание</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>вот</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>ну как бы я понимала что еще математика была и я сдавала профильную математику</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645"
                TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>и я сдавала профильную математику</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts145">
